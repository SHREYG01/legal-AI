# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_assistant

# --- Vector store ---
CHROMA_PERSIST_DIR=./chroma_db

# --- LLM provider (used for summarization, Q&A generation) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_api_key_here
LLM_MODEL=claude-sonnet-5

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Clause classification ---
# Default: pretrained NLI model used zero-shot (NOT fine-tuned on legal data).
CLASSIFICATION_MODEL=facebook/bart-large-mnli
# Optional: path to a locally fine-tuned LegalBERT/RoBERTa checkpoint. If set
# and loadable, this takes priority over the zero-shot model. Leave blank
# unless you actually have a trained checkpoint (see backend/train/README.md).
FINE_TUNED_MODEL_PATH=

# --- App ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
